; ---------------------------------------------------------------------------
;  Krypt Studio - custom NSIS installer additions (kryptguidelines §7.3).
;
;  Finish page: "Run Krypt Studio" (electron-builder's default behaviour) plus
;  an opt-in "Create desktop shortcut" checkbox. createDesktopShortcut is
;  false in package.json, so the user gets a real choice.
;
;  Gotchas (house guide §7.3):
;   * electron-builder includes this file BEFORE its own templates, so only
;     command-line defines exist at top level: use ${APP_FILENAME}.exe (not
;     ${APP_EXECUTABLE_FILENAME}, which common.nsh defines later).
;   * Anything that needs the templates' variables/macros ($launchLink,
;     ${isUpdated}, StdUtils) lives INSIDE customFinishPage, which is expanded
;     later by assistedInstaller.nsh. The shortcut function is referenced there.
;   * electron-builder runs makensis a second time with BUILD_UNINSTALLER
;     defined. A top-level Function must be wrapped in
;     !ifndef BUILD_UNINSTALLER ... !endif, or it lands in the uninstaller
;     pass unreferenced (warning 6010, fatal under -WX).
;
;  Start with Windows: a fresh install adds Krypt Studio to the current user's
;  startup (HKCU Run, value "${PRODUCT_NAME}", launched with --hidden so it
;  opens quietly in the tray). Updates leave the entry alone: the app keeps it
;  in step with Settings > Start with Windows (electron/system/background.ts,
;  same value name). A real uninstall removes it.
;
;  The .kstudio file association is generated by electron-builder from
;  build.fileAssociations in package.json (registered on install, removed on
;  uninstall).
; ---------------------------------------------------------------------------

!ifndef BUILD_UNINSTALLER
  Function KryptCreateDesktopShortcut
    CreateShortCut "$DESKTOP\${PRODUCT_FILENAME}.lnk" "$INSTDIR\${APP_FILENAME}.exe" "" "$INSTDIR\${APP_FILENAME}.exe" 0
  FunctionEnd
!endif

!macro customFinishPage
  ; Run-after-finish checkbox (same behaviour as electron-builder's default page).
  Function KryptStartApp
    ${if} ${isUpdated}
      StrCpy $1 "--updated"
    ${else}
      StrCpy $1 ""
    ${endif}
    ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$1"
  FunctionEnd
  !define MUI_FINISHPAGE_RUN
  !define MUI_FINISHPAGE_RUN_FUNCTION "KryptStartApp"

  ; Second checkbox: MUI's SHOWREADME slot reused as an arbitrary toggle. Its
  ; value is irrelevant because we provide our own callback.
  !define MUI_FINISHPAGE_SHOWREADME "_"
  !define MUI_FINISHPAGE_SHOWREADME_NOTCHECKED
  !define MUI_FINISHPAGE_SHOWREADME_TEXT "Create desktop shortcut"
  !define MUI_FINISHPAGE_SHOWREADME_FUNCTION KryptCreateDesktopShortcut

  !insertmacro MUI_PAGE_FINISH
!macroend

; Remove the opt-in desktop shortcut (per-user and all-users desktops) on a
; real uninstall. Skipped when the old version is uninstalled as part of an
; update, so the shortcut the user chose survives upgrades. Not guarded by
; BUILD_UNINSTALLER: this macro only runs in the uninstaller pass, and the
; shell context is restored afterwards (the rest of the uninstall section
; reads SHELL_CONTEXT registry keys and $SMPROGRAMS).
; User data in %APPDATA%\Krypt Studio (settings, autosaves, logs, mcp.json) is
; preserved on purpose so a reinstall keeps your setup; delete it to reset.
!macro customInstall
  ${ifNot} ${isUpdated}
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${PRODUCT_NAME}" '"$INSTDIR\${APP_FILENAME}.exe" --hidden'
  ${endIf}
!macroend

!macro customUnInstall
  ${ifNot} ${isUpdated}
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${PRODUCT_NAME}"
    SetShellVarContext current
    Delete "$DESKTOP\${PRODUCT_FILENAME}.lnk"
    SetShellVarContext all
    Delete "$DESKTOP\${PRODUCT_FILENAME}.lnk"
    ${if} $installMode == "all"
      SetShellVarContext all
    ${else}
      SetShellVarContext current
    ${endif}
  ${endIf}
!macroend

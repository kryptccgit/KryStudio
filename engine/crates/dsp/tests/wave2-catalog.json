    {
      "id": "krypt.chorus",
      "name": "Krypt Chorus",
      "kind": "effect",
      "category": "Modulation",
      "description": "Multi-voice chorus and ensemble: 1-6 modulated delay voices per side with staggered delays and rates. Stereo spread offsets the right side's LFOs (a mono source turns wide). Depth 1 sweeps up to ±5 ms. Low/high cut shape the wet signal only, so bass stays mono and tight. Has its own Mix (50% = classic chorus). Zero latency.",
      "params": [
        {
          "id": "voices",
          "name": "Voices",
          "min": 1,
          "max": 6,
          "default": 3,
          "unit": "",
          "scale": "linear",
          "step": 1,
          "group": "Chorus"
        },
        {

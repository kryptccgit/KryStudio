    {
      "id": "krypt.fm",
      "name": "Krypt FM",
      "kind": "instrument",
      "category": "Synth",
      "description": "Four-operator FM synth: 8 algorithms (stack, pairs, one-to-many, additive), op 4 feedback, per-operator ratio (coarse x (1 + fine)), detune, level, velocity sensitivity and AHDSR. Default patch is an electric piano (pairs: 1:1 body + 14:1 tine); bells, basses, brass, organs and pads are a few knobs away. 2x oversampled, plus filter with envelope, vibrato, Mod X = cutoff, Mod Y = brightness.",
      "params": [
        {
          "id": "algorithm",
          "name": "Algorithm",
          "min": 0,
          "max": 7,
          "default": 4,
          "unit": "",
          "scale": "linear",
          "step": 1,
          "options": [
            "1: 4>3>2>1 stack",
            "2: (4+3)>2>1",
            "3: (3>2)+4 > 1",
            "4: (4>3)+2 > 1",
            "5: 4>3 + 2>1 pairs",
            "6: 4 > 3+2+1",
            "7: 4>3 + 2 + 1",
            "8: 4+3+2+1 additive"
          ],
          "group": "Algorithm"
        },
        {
          "id": "feedback",
          "name": "Op 4 feedback",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "%",
          "scale": "linear",
          "group": "Algorithm"

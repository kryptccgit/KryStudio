    {
      "id": "krypt.sampler",
      "name": "Krypt Sampler",
      "kind": "instrument",
      "category": "Sampler",
      "usesSample": true,
      "description": "Plays a sample across the keyboard with envelope, filter, reverse and loop. The default drum/one-shot channel.",
      "params": [
        {
          "id": "oneShot",
          "name": "One-shot (ignore note length)",
          "min": 0,
          "max": 1,
          "default": 1,
          "unit": "",
          "scale": "linear",
          "step": 1,
          "options": [
            "Off",
            "On"
          ],
          "group": "Playback"
        },
        {
          "id": "start",
          "name": "Start",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "%",
          "scale": "linear",
          "group": "Playback"
        },
        {
          "id": "reverse",
          "name": "Reverse",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "",
          "scale": "linear",
          "step": 1,
          "options": [
            "Off",
            "On"
          ],
          "group": "Playback"
        },
        {
          "id": "loop",
          "name": "Loop",
          "min": 0,
          "max": 1,
          "default": 0,
          "unit": "",
          "scale": "linear",
          "step": 1,
          "options": [
            "Off",
            "On"
          ],
          "group": "Playback"

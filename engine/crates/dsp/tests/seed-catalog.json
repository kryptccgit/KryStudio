          "group": "Playback"
        },
        {
          "id": "gain",
          "name": "Gain",
          "min": -24,
          "max": 24,
          "default": 0,
          "unit": "dB",
          "scale": "linear",
          "group": "Playback"
        },
        {
          "id": "ampAttack",
          "name": "Attack",
          "min": 0.1,
          "max": 5000,
          "default": 0.1,
          "unit": "ms",
          "scale": "log",
          "group": "Envelope"
